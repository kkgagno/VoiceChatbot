<Window x:Class="VoiceChatbot.KnowledgeTextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VoiceChatbot"
        Title="Indexed text"
        Width="860" Height="640"
        MinWidth="440" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource DarkBgBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="2,0,2,10">
            <TextBlock x:Name="FileText" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="InfoText" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <TextBox x:Name="TextView" Grid.Row="1" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                 AcceptsReturn="True" AcceptsTab="False" TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                 FontFamily="{StaticResource CodeFont}" FontSize="12"
                 Background="{DynamicResource CodeBlockBrush}" Foreground="{DynamicResource CodeTextBrush}"
                 VerticalContentAlignment="Top"/>

        <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="False">
            <Button Content="Copy" local:Ui.Icon="&#xE8C8;" Style="{StaticResource SecondaryButton}"
                    Click="Copy_Click" ToolTip="Copy all of this text"/>
            <CheckBox x:Name="WrapBox" Content="Wrap long lines" Margin="12,0,0,0" VerticalAlignment="Center"
                      Checked="Wrap_Changed" Unchecked="Wrap_Changed"/>
            <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource SecondaryButton}" IsCancel="True"
                    Click="Close_Click"/>
            <TextBlock x:Name="StatusText" DockPanel.Dock="Right" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"
                       Foreground="{DynamicResource TextMutedBrush}"/>
        </DockPanel>
    </Grid>
</Window>
