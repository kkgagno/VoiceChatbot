<Window x:Class="VoiceChatbot.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VoiceChatbot"
        Title="Voice Chatbot Mini Help"
        Width="1040" Height="740"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource DarkBgBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!-- Topics come from Core/HelpContent.cs; this window only lays them out (HelpWindow.xaml.cs). -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" MinWidth="220" MaxWidth="440"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Topic list with search -->
        <Border Background="{DynamicResource PanelBgBrush}">
            <DockPanel Margin="14,16,8,12">
                <Grid DockPanel.Dock="Top" Margin="4,0,6,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource BrandGradientBrush}">
                        <TextBlock Text="&#xE897;" Style="{StaticResource IconText}" FontSize="16" Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Help" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="Every menu and option, explained" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,6,8"
                         local:Ui.Placeholder="Search help (Ctrl+F)"
                         TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"
                         ToolTip="Type a word such as microphone, Kokoro, PIN or Ollama. Enter opens the best match."/>
                <TextBlock x:Name="SearchResultText" DockPanel.Dock="Top" Style="{StaticResource FieldHint}"
                           Margin="4,0,6,8" Visibility="Collapsed"/>

                <ListBox x:Name="TopicList" SelectionChanged="TopicList_SelectionChanged" Margin="0,0,4,0"
                         KeyboardNavigation.TabNavigation="Once">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="Bold"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="10,12,0,6"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Icon}" Style="{StaticResource IconText}" FontSize="13"
                                           Foreground="{DynamicResource PrimaryLightBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" Margin="6,0,0,0"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

        <!-- The selected topic -->
        <DockPanel Grid.Column="2">
            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,10,18,12">
                <DockPanel LastChildFill="False">
                    <Button x:Name="PreviousBtn" Content="Previous" local:Ui.Icon="&#xE72B;" Style="{StaticResource SecondaryButton}"
                            Click="Previous_Click"/>
                    <Button x:Name="NextBtn" Content="Next" local:Ui.Icon="&#xE72A;" Style="{StaticResource ActionButton}"
                            Click="Next_Click" Margin="6,0,0,0"/>
                    <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource SecondaryButton}" Click="Close_Click"
                            ToolTip="Close Help (Esc)"/>
                    <TextBlock x:Name="PositionText" DockPanel.Dock="Right" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </DockPanel>
            </Border>

            <RichTextBox x:Name="TopicView" IsReadOnly="True" IsDocumentEnabled="True" IsUndoEnabled="False"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         SelectionBrush="{DynamicResource PrimaryBrush}" SelectionOpacity="0.45"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         FocusVisualStyle="{x:Null}" AutomationProperties.Name="Help topic"/>
        </DockPanel>
    </Grid>
</Window>
