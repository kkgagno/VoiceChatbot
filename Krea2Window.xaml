<Window x:Class="VoiceChatbot.Krea2Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Krea2 Turbo"
        Width="720" Height="780"
        MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#F6F7F9">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Krea2 Turbo" FontSize="24" FontWeight="SemiBold" Foreground="#111111"/>
            <TextBlock Text="Uses ComfyUI workflow image_krea2_turbo_t2i_OFFICIAL."
                       FontSize="12" Foreground="#555555" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#DDDDDD" BorderThickness="1"
                CornerRadius="12" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Prompt" FontWeight="SemiBold" Foreground="#111111"/>
                <TextBox x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="90" MaxHeight="160" Margin="0,5,0,12"
                         Foreground="Black" Background="White" BorderBrush="#CCCCCC"
                         VerticalScrollBarVisibility="Auto"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Picture size" FontWeight="SemiBold" Foreground="#111111"/>
                        <ComboBox x:Name="AspectCombo" Margin="0,5,0,0"
                                  Foreground="Black" Background="White"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="LoRA" FontWeight="SemiBold" Foreground="#111111"/>
                        <CheckBox x:Name="EnableLoraToggle" Content="Enable_lora?"
                                  Foreground="#111111" Margin="0,8,0,4"
                                  Checked="EnableLoraToggle_Changed"
                                  Unchecked="EnableLoraToggle_Changed"/>
                        <ComboBox x:Name="LoraCombo"
                                  Foreground="Black" Background="White"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RefreshLorasBtn" Content="Refresh LoRAs"
                            Click="RefreshLoras_Click" MinWidth="120" Margin="0,0,8,0"
                            Padding="12,7"/>
                    <Button x:Name="CreateBtn" Content="Create Krea2 Image"
                            Click="Create_Click" MinWidth="150"
                            Padding="12,7" Background="#111111" Foreground="White"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#DDDDDD" BorderThickness="1"
                CornerRadius="12" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="#555555" Margin="0,0,0,10"/>
                <ScrollViewer Grid.Row="1">
                    <StackPanel>
                        <TextBlock x:Name="ResultText" TextWrapping="Wrap" Foreground="#111111"/>
                        <Image x:Name="ResultImage" Stretch="Uniform" MaxHeight="420" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="SaveImageBtn" Content="Save Image" Click="SaveImage_Click"
                    IsEnabled="False" Padding="12,7" MinWidth="110" Margin="0,0,8,0"/>
            <Button Content="Close" Click="Close_Click" Padding="12,7" MinWidth="90"/>
        </StackPanel>
    </Grid>
</Window>
