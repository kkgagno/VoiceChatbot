<Window x:Class="VoiceChatbot.AdkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Google ADK"
        Width="1400"
        Height="900"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#F4F5F7">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#D7DDE5" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Google ADK"
                           FontWeight="Bold"
                           FontSize="16"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <TextBox x:Name="UrlBox"
                         Grid.Column="1"
                         Foreground="Black"
                         Background="White"
                         BorderBrush="#CDD3DC"
                         Padding="8,6"
                         VerticalContentAlignment="Center"
                         KeyDown="UrlBox_KeyDown"/>
                <Button Grid.Column="2"
                        Content="Reload"
                        MinWidth="90"
                        Margin="10,0,0,0"
                        Padding="10,6"
                        Click="Reload_Click"/>
                <Button Grid.Column="3"
                        Content="Open in Browser"
                        MinWidth="120"
                        Margin="8,0,0,0"
                        Padding="10,6"
                        Click="OpenBrowser_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#D7DDE5" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <Grid>
                <wv2:WebView2 x:Name="AdkWebView"/>
                <Border x:Name="LoadingOverlay"
                        Background="#DDFFFFFF"
                        Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="220" Height="6" Margin="0,0,0,12"/>
                        <TextBlock Text="Loading ADK..." Foreground="#333333" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
