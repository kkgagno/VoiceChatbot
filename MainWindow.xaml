<Window x:Class="VoiceChatbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voice Chatbot 2.0"
        Width="1100" Height="900"
        MinWidth="980" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource DarkBgBrush}"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>


        <!-- ===================== LEFT PANEL ===================== -->
        <Border x:Name="SettingsPanel" Width="340" HorizontalAlignment="Left"
                Margin="0,66,0,0" Panel.ZIndex="10"
                Background="#F4F5F6" BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="0,0,1,0" CornerRadius="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12">
                <StackPanel>

                    <!-- Title -->
                    <TextBlock Text="VOICE CHATBOT 2.0" FontSize="17" FontWeight="Bold"
                               Foreground="#111111" HorizontalAlignment="Center" Margin="0,10,0,14"/>
                    <!-- Connection -->
                    <Border Background="White" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="CONNECTION" FontSize="9" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="StatusText" Text="Disconnected" FontSize="12" Foreground="#E17055" VerticalAlignment="Center"/>
                                <Ellipse x:Name="StatusDot" Width="10" Height="10" Grid.Column="1" Fill="#E17055" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Phone Remote -->
                    <Border Background="White" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="IPHONE REMOTE" FontSize="9" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,6"/>
                            <TextBlock x:Name="PhoneRemoteStatusText" Text="Stopped" FontSize="12" Foreground="#222222" Margin="0,0,0,6" TextWrapping="Wrap"/>
                            <ToggleButton x:Name="PhoneRemoteToggle" Content="Phone Remote OFF" IsChecked="False"
                                          Style="{StaticResource ToggleFlatButton}" HorizontalAlignment="Left"
                                          Click="PhoneRemoteToggle_Click" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Port" FontSize="11" Foreground="#222222" VerticalAlignment="Center"/>
                                <TextBox x:Name="PhoneRemotePortBox" Grid.Column="1" Text="5100" Foreground="Black" Background="White"
                                         BorderBrush="#CCCCCC"/>
                            </Grid>
                            <TextBlock Text="PIN optional" FontSize="11" Foreground="#222222" Margin="0,0,0,2"/>
                            <TextBox x:Name="PhoneRemotePinBox" Foreground="Black" Background="White" BorderBrush="#CCCCCC"
                                     Margin="0,0,0,6"/>
                            <ToggleButton x:Name="PhoneRemoteAudioToggle" Content="Phone Audio ON" IsChecked="True"
                                          Style="{StaticResource ToggleFlatButton}" HorizontalAlignment="Left"
                                          Click="PhoneRemoteAudioToggle_Click" Margin="0,0,0,6"/>
                            <Button x:Name="PhoneRemoteStartStopBtn" Content="Start Phone Remote" Style="{StaticResource ActionButton}"
                                    Click="PhoneRemoteStartStop_Click" Margin="0,0,0,4"/>
                            <Button x:Name="PhoneRemoteCopyUrlBtn" Content="Copy Phone URL" Style="{StaticResource ActionButton}"
                                    Click="PhoneRemoteCopyUrl_Click" Margin="0,0,0,4"/>
                            <Button x:Name="PhoneRemoteCertBtn" Content="Open Certificate Folder" Style="{StaticResource ActionButton}"
                                    Click="PhoneRemoteCert_Click" Margin="0,0,0,6"/>
                            <TextBlock x:Name="PhoneRemoteHelpText" Text="Install and fully trust the .cer file on iPhone once, then open the URL while on the same Wi-Fi."
                                       FontSize="10" Foreground="#666666" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Face Presence -->
                    <Border Background="White" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="FACE PRESENCE" FontSize="9" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="FacePresenceText" Text="Camera features off" FontSize="12" Foreground="#888888" VerticalAlignment="Center"/>
                                <Ellipse x:Name="FacePresenceDot" Width="10" Height="10" Grid.Column="1" Fill="#888888" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                            <ToggleButton x:Name="FaceFeaturesToggle" Content="Camera OFF" IsChecked="False"
                                          Style="{StaticResource ToggleFlatButton}" HorizontalAlignment="Left"
                                          Click="FaceFeaturesToggle_Click" Margin="0,0,0,4"/>
                            <ToggleButton x:Name="FaceGatingToggle" Content="Use Identity OFF" IsChecked="False"
                                          Style="{StaticResource ToggleFlatButton}" HorizontalAlignment="Left"
                                          Click="FaceGatingToggle_Click" Margin="0,0,0,6"/>
                            <Border Background="#111111" Height="130" CornerRadius="4" Margin="0,0,0,6">
                                <Image x:Name="FacePreviewImage" Stretch="Uniform"/>
                            </Border>
                            <TextBlock x:Name="FaceIdentityText" Text="Identity: Unknown" FontSize="11" Foreground="#222222" Margin="0,2,0,6" TextWrapping="Wrap"/>
                            <TextBlock x:Name="FaceDebugText" Text="Samples: 0 | Model: SFace ONNX" FontSize="10" Foreground="#666666" Margin="0,0,0,6" TextWrapping="Wrap"/>
                            <Button x:Name="FaceSnapshotBtn" Content="Scan Face Once" Style="{StaticResource ActionButton}"
                                    Click="FaceSnapshot_Click" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="FaceProfileCombo" Foreground="Black" Background="White" SelectedIndex="0" Margin="0,0,6,0"
                                          IsEditable="True" Text="Keith"
                                          SelectionChanged="FaceProfileCombo_SelectionChanged">
                                    <ComboBoxItem Foreground="Black" Content="Keith"/>
                                </ComboBox>
                                <Button x:Name="EnrollFaceBtn" Grid.Column="1" Content="Save Face" Style="{StaticResource ActionButton}"
                                        Click="EnrollFace_Click" MinWidth="70"/>
                            </Grid>
                            <Button x:Name="ClearFacesBtn" Content="Clear Face Samples" Style="{StaticResource ActionButton}"
                                    Click="ClearFaces_Click" Margin="0,0,0,6" Background="{StaticResource ErrorBrush}"/>
                            <TextBlock x:Name="FacePolicyText" Text="Face gating disabled" FontSize="10" Foreground="#888888" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Chat Backend -->
                    <Border Background="White" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="CHAT BACKEND" FontSize="9" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,6"/>
                            <TextBlock Text="Provider" FontSize="11" Foreground="#222222" Margin="0,0,0,2"/>
                            <ComboBox x:Name="ProviderCombo" Foreground="Black" Background="White" Margin="0,0,0,8"
                                      SelectionChanged="ProviderCombo_SelectionChanged">
                                <ComboBoxItem Foreground="Black" Content="Ollama"/>
                                <ComboBoxItem Foreground="Black" Content="OpenAI-compatible"/>
                            </ComboBox>

                            <TextBlock Text="Ollama URL" FontSize="11" Foreground="#222222" Margin="0,0,0,2"/>
                            <TextBox x:Name="OllamaUrlBox" Foreground="Black" Background="White" Text="http://localhost:11434" Margin="0,0,0,8" BorderBrush="#CCCCCC"/>

                            <TextBlock Text="OpenAI / llama.cpp URL" FontSize="11" Foreground="#222222" Margin="0,0,0,2"/>
                            <TextBox x:Name="OpenAiUrlBox" Foreground="Black" Background="White" Text="http://localhost:8080/v1" Margin="0,0,0,8" BorderBrush="#CCCCCC"/>

                            <TextBlock Text="OpenAI API Key optional" FontSize="11" Foreground="#222222" Margin="0,0,0,2"/>
                            <PasswordBox x:Name="OpenAiApiKeyBox" Foreground="Black" Background="White" Margin="0,0,0,8" BorderBrush="#CCCCCC"/>

                            <TextBlock Text="Hermes SSH Host" FontSize="11" Foreground="#222222" Margin="0,0,0,2"/>
                            <TextBox x:Name="HermesSshHostBox" Foreground="Black" Background="White" Text="127.0.0.1" Margin="0,0,0,8" BorderBrush="#CCCCCC"/>

                            <TextBlock Text="Hermes SSH Port" FontSize="11" Foreground="#222222" Margin="0,0,0,2"/>
                            <TextBox x:Name="HermesSshPortBox" Foreground="Black" Background="White" Text="2222" Margin="0,0,0,8" BorderBrush="#CCCCCC"/>

                            <TextBlock Text="Hermes SSH User" FontSize="11" Foreground="#222222" Margin="0,0,0,2"/>
                            <TextBox x:Name="HermesSshUserBox" Foreground="Black" Background="White" Margin="0,0,0,8" BorderBrush="#CCCCCC"/>

                            <TextBlock Text="Hermes SSH Password" FontSize="11" Foreground="#222222" Margin="0,0,0,2"/>
                            <PasswordBox x:Name="HermesSshPasswordBox" Foreground="Black" Background="White" Margin="0,0,0,8" BorderBrush="#CCCCCC"/>

                            <TextBlock Text="Model" FontSize="11" Foreground="#222222" Margin="0,0,0,2"/>
                            <ComboBox x:Name="ModelCombo" Foreground="Black" Background="White" Margin="0,0,0,6" IsEditable="True"/>

                            <Button x:Name="RefreshModelsBtn" Content="Refresh Models" Style="{StaticResource ActionButton}" Click="RefreshModels_Click" Margin="0,0,0,8"/>

                            <Border Background="#F4F5F7" BorderBrush="#D7D9DE" BorderThickness="1" CornerRadius="6"
                                    Padding="8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="MODEL / COMFY CONTROL" FontSize="9" FontWeight="Bold"
                                               Foreground="#777777" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="ModelControlStatusText" Text="Checking services..."
                                               FontSize="10" Foreground="#555555" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <Button x:Name="StopCurrentModelBtn" Content="Stop Current Model"
                                            Style="{StaticResource ActionButton}" Click="StopCurrentModel_Click"
                                            Background="{StaticResource ErrorBrush}" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="LaunchModelCombo" Foreground="Black" Background="White"
                                                  MinWidth="120" IsEnabled="False"/>
                                        <Button x:Name="StartSelectedModelBtn" Grid.Column="2" Content="Start Model"
                                                Style="{StaticResource ActionButton}" Click="StartSelectedModel_Click"
                                                IsEnabled="False" MinWidth="82"/>
                                    </Grid>
                                    <Button x:Name="ComfyUiStartStopBtn" Content="Start ComfyUI"
                                            Style="{StaticResource ActionButton}" Click="ComfyUiStartStop_Click"
                                            IsEnabled="False"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="System Prompt" FontSize="11" Foreground="#222222" Margin="0,0,0,2"/>
                            <TextBox x:Name="SystemPromptBox" Foreground="Black" Background="White" TextWrapping="Wrap" AcceptsReturn="True"
                                     MinHeight="50" MaxHeight="80" Margin="0,0,0,8" BorderBrush="#CCCCCC"
                                     Text="You are a helpful, friendly AI assistant. Keep responses concise and conversational since they will be spoken aloud. IMPORTANT: Never use emojis, hashtags, asterisks, markdown formatting, or special symbols in normal conversation. If the user explicitly asks for code, markup, an SVG, or a script, provide it in a fenced code block."/>

                            <TextBlock Text="Temperature" FontSize="11" Foreground="#222222" Margin="0,0,0,2"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="TempSlider" Minimum="0" Maximum="2" Value="0.7" SmallChange="0.1" LargeChange="0.2" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TempValue" Grid.Column="1" Text="0.7" FontSize="11" Foreground="#222222" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Image Backend -->
                    <Border Background="White" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="IMAGE BACKEND" FontSize="9" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,6"/>
                            <TextBlock Text="ComfyUI URL" FontSize="11" Foreground="#222222" Margin="0,0,0,2"/>
                            <TextBox x:Name="ComfyUrlBox" Foreground="Black" Background="White"
                                     Text="http://localhost:8000" Margin="0,0,0,8" BorderBrush="#CCCCCC"/>

                            <TextBlock Text="Qwen Image Size" FontSize="11" Foreground="#222222" Margin="0,0,0,2"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ImageWidthBox" Foreground="Black" Background="White" Text="1080" BorderBrush="#CCCCCC"/>
                                <TextBox x:Name="ImageHeightBox" Grid.Column="2" Foreground="Black" Background="White" Text="1920" BorderBrush="#CCCCCC"/>
                            </Grid>

                            <TextBlock Text="Create / Edit Steps" FontSize="11" Foreground="#222222" Margin="0,0,0,2"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="QwenCreateStepsBox" Foreground="Black" Background="White" Text="4" BorderBrush="#CCCCCC"/>
                                <TextBox x:Name="QwenEditStepsBox" Grid.Column="2" Foreground="Black" Background="White" Text="40" BorderBrush="#CCCCCC"/>
                            </Grid>

                            <TextBlock Text="Video Seconds / FPS" FontSize="11" Foreground="#222222" Margin="0,4,0,2"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="VideoSecondsBox" Foreground="Black" Background="White" Text="6" BorderBrush="#CCCCCC"/>
                                <TextBox x:Name="VideoFpsBox" Grid.Column="2" Foreground="Black" Background="White" Text="24" BorderBrush="#CCCCCC"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Voice Input -->
                    <Border Background="White" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="VOICE INPUT" FontSize="9" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,6"/>
                            <TextBlock Text="Microphone" FontSize="11" Foreground="#222222" Margin="0,0,0,2"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="MicCombo" Foreground="Black" Background="White" Margin="0,0,6,0"
                                          SelectionChanged="MicCombo_SelectionChanged"/>
                                <Button x:Name="RefreshMicsBtn" Grid.Column="1" Content="Refresh" FontSize="10"
                                        Click="RefreshMics_Click" Padding="6,2"/>
                            </Grid>

                            <TextBlock Text="Recognition Language" FontSize="11" Foreground="#222222" Margin="0,0,0,2"/>
                            <ComboBox x:Name="InputLangCombo" Foreground="Black" Background="White" Margin="0,0,0,8"/>

                            <TextBlock Text="Whisper Model" FontSize="11" Foreground="#222222" Margin="0,0,0,2"/>
                            <ComboBox x:Name="WhisperModelCombo" Foreground="Black" Background="White" Margin="0,0,0,4">
                                <ComboBoxItem Foreground="Black" Content="tiny"/>
                                <ComboBoxItem Foreground="Black" Content="base"/>
                                <ComboBoxItem Foreground="Black" Content="small" IsSelected="True"/>
                                <ComboBoxItem Foreground="Black" Content="medium"/>
                            </ComboBox>
                            <Button x:Name="DownloadModelBtn" Content="Download Model" Style="{StaticResource ActionButton}" Click="DownloadModel_Click" Margin="0,0,0,8" Background="{StaticResource AccentBrush}"/>

                            <TextBlock Text="Transcription Backend" FontSize="11" Foreground="#222222" Margin="0,0,0,2"/>
                            <ComboBox x:Name="TranscriptionBackendCombo" Foreground="Black" Background="White" Margin="0,0,0,6">
                                <ComboBoxItem Foreground="Black" Content="Whisper.net"/>
                                <ComboBoxItem Foreground="Black" Content="AMD Ryzen AI Whisper"/>
                                <ComboBoxItem Foreground="Black" Content="AMD Ryzen AI Whisper with fallback"/>
                            </ComboBox>

                            <TextBlock Text="Ryzen AI Command" FontSize="11" Foreground="#222222" Margin="0,0,0,2"/>
                            <TextBox x:Name="NpuTranscriberCommandBox" Foreground="Black" Background="White" TextWrapping="Wrap"
                                     MinHeight="40" MaxHeight="70" Margin="0,0,0,8" BorderBrush="#CCCCCC"
                                     ToolTip="Command that transcribes a WAV file with AMD Ryzen AI Whisper. Use {input} where the WAV path should go; stdout should be transcript text."/>

                            <TextBlock Text="Silence Timeout" FontSize="11" Foreground="#222222" Margin="0,0,0,2"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SilenceSlider" Minimum="0.5" Maximum="8" Value="2.4" SmallChange="0.1" LargeChange="0.5" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SilenceValue" Grid.Column="1" Text="2.4" FontSize="11" Foreground="#222222" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <TextBlock Text="Noise Suppression" FontSize="11" Foreground="#222222" Margin="0,0,0,2"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="NoiseSlider" Minimum="0" Maximum="100" Value="30" SmallChange="5" LargeChange="10" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NoiseValue" Grid.Column="1" Text="30%" FontSize="11" Foreground="#222222" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <TextBlock Text="Auto-detect voice" FontSize="11" Foreground="#222222" Margin="0,8,0,2"/>
                            <ToggleButton x:Name="AutoDetectToggle" Content="ON" IsChecked="True" Style="{StaticResource ToggleFlatButton}" HorizontalAlignment="Left" Click="AutoDetectToggle_Click" Margin="0,0,0,4"/>

                            <TextBlock Text="Wake Word" FontSize="11" Foreground="#222222" Margin="0,0,0,2"/>
                            <TextBox x:Name="WakeWordBox" Foreground="Black" Background="White" Text="hey assistant" IsEnabled="False" Margin="0,0,0,4" BorderBrush="#CCCCCC"/>
                        </StackPanel>
                    </Border>

                    <!-- Voice Output -->
                    <Border Background="White" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="VOICE OUTPUT" FontSize="9" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,6"/>
                            <TextBlock Text="Voice" FontSize="11" Foreground="#222222" Margin="0,0,0,2"/>
                            <ComboBox x:Name="VoiceCombo" Foreground="Black" Background="White" Margin="0,0,0,8"/>

                            <TextBlock Text="Speech Rate" FontSize="11" Foreground="#222222" Margin="0,0,0,2"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="RateSlider" Minimum="-5" Maximum="5" Value="1" SmallChange="1" LargeChange="1" VerticalAlignment="Center"/>
                                <TextBlock x:Name="RateValue" Grid.Column="1" Text="+1" FontSize="11" Foreground="#222222" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <TextBlock Text="Volume" FontSize="11" Foreground="#222222" Margin="0,0,0,2"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="80" SmallChange="5" LargeChange="10" VerticalAlignment="Center"/>
                                <TextBlock x:Name="VolumeValue" Grid.Column="1" Text="80%" FontSize="11" Foreground="#222222" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <ToggleButton x:Name="TtsToggle" Content="Speech ON" IsChecked="True" Style="{StaticResource ToggleFlatButton}" HorizontalAlignment="Left" Click="TtsToggle_Click" Margin="0,0,0,4"/>
                        </StackPanel>
                    </Border>

                    <!-- Conversation -->
                    <Border Background="White" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="CONVERSATION" FontSize="9" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,6"/>
                            <TextBlock Text="Max Context" FontSize="11" Foreground="#222222" Margin="0,0,0,2"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="ContextSlider" Minimum="2" Maximum="50" Value="20" SmallChange="1" LargeChange="5" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ContextValue" Grid.Column="1" Text="20" FontSize="11" Foreground="#222222" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <ToggleButton x:Name="StreamToggle" Content="Stream responses" IsChecked="True" Style="{StaticResource ToggleFlatButton}" HorizontalAlignment="Left" Click="StreamToggle_Click" Margin="0,0,0,8"/>

                            <Button x:Name="SummarizeBtn" Content="Save Memory" Style="{StaticResource ActionButton}" Click="SummarizeConversation_Click" Margin="0,0,0,4" Background="#6C5CE7"/>
                            <Button x:Name="ViewMemoryBtn" Content="View Memory" Style="{StaticResource ActionButton}" Click="ViewMemory_Click" Margin="0,0,0,4"/>
                            <Button x:Name="ClearChatBtn" Content="Clear Chat" Style="{StaticResource ActionButton}" Click="ClearChat_Click" Margin="0,0,0,4" Background="{StaticResource ErrorBrush}"/>
                            <Button x:Name="ExportBtn" Content="Export Chat" Style="{StaticResource ActionButton}" Click="ExportChat_Click" Margin="0,0,0,4"/>
                        </StackPanel>
                    </Border>

                    <!-- Web Search -->
                    <Border Background="White" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="WEB SEARCH" FontSize="9" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,6"/>
                            <ToggleButton x:Name="WebSearchToggle" Content="Web Search ON" IsChecked="True"
                                          Style="{StaticResource ToggleFlatButton}" HorizontalAlignment="Left"
                                          Click="WebSearchToggle_Click" Margin="0,0,0,8"/>

                            <TextBlock Text="Tavily API Key" FontSize="11" Foreground="#222222" Margin="0,0,0,2"/>
                            <PasswordBox x:Name="TavilyApiKeyBox" Foreground="Black" Background="White"
                                         Margin="0,0,0,4" BorderBrush="#CCCCCC"/>
                        </StackPanel>
                    </Border>

                    <!-- Memory Viewer (collapsible) -->
                    <Border x:Name="MemoryPanel" Background="White" CornerRadius="6" Padding="10" Margin="0,0,0,8" Visibility="Collapsed">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="SAVED MEMORIES" FontSize="9" FontWeight="Bold" Foreground="#888888" VerticalAlignment="Center"/>
                                <Button Content="X" FontSize="9" HorizontalAlignment="Right" Padding="4,1" 
                                        Click="CloseMemoryPanel_Click" Background="#E17055" Foreground="White" BorderThickness="0"/>
                            </Grid>
                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="MemoryListPanel"/>
                            </ScrollViewer>
                            <Button x:Name="AddManualMemoryBtn" Content="Add Memory" FontSize="10"
                                    Click="AddManualMemory_Click" Margin="0,4,0,0" Padding="4,2"
                                    Background="#00B894" Foreground="White" BorderThickness="0"/>
                            <Button x:Name="ClearMemoryBtn" Content="Clear All Memory" FontSize="10"
                                    Click="ClearMemory_Click" Margin="0,4,0,0" Padding="4,2"
                                    Background="{StaticResource ErrorBrush}" Foreground="White" BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ===================== RIGHT PANEL - Chat ===================== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="0,0,0,1" Padding="20,14" CornerRadius="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status indicator -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="54,0,0,0">
                        <Ellipse x:Name="StateIndicator" Width="12" Height="12" Fill="{StaticResource SuccessBrush}" Margin="0,0,10,0"/>
                        <TextBlock x:Name="StateLabel" Text="Ready" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Quick actions -->
                    <StackPanel Orientation="Horizontal" Grid.Column="1">
                        <ToggleButton x:Name="DarkModeToggle"
                                      Style="{StaticResource ThemeSwitch}"
                                      Click="DarkModeToggle_Click"
                                      Margin="0,0,8,0"
                                      ToolTip="Switch between light and dark appearance"/>
                        <Button x:Name="SchedulerBtn" Content="Scheduler"
                                Style="{StaticResource ActionButton}"
                                Click="Scheduler_Click" Margin="0,0,8,0"
                                Width="92"/>
                        <Button x:Name="MicBtn" Content="Mic" Style="{StaticResource ActionButton}" 
                                Click="MicToggle_Click" Margin="0,0,8,0" Width="80"/>
                        <Button x:Name="TranscribeBtn" Content="Transcribe" Style="{StaticResource ActionButton}"
                                Click="Transcribe_Click" Margin="0,0,8,0" Width="105"
                                Background="#A6E3A1" Foreground="#11111B"
                                ToolTip="Open live transcription and summarization window"/>
                        <Button x:Name="ListenBtn" Content="Listen" Style="{StaticResource ActionButton}"
                                Click="ListenToggle_Click" Margin="0,0,8,0" Width="85"
                                Background="{StaticResource SuccessBrush}"/>
                        <ToggleButton x:Name="AlwaysListenToggle" Content=" Auto" 
                                      Style="{StaticResource ToggleFlatButton}" Margin="0,0,8,0"
                                      ToolTip="Continuously listen and respond"/>
                        <Button x:Name="StopBtn" Content="Stop" Style="{StaticResource ActionButton}"
                                Click="StopAll_Click" Width="70" Background="{StaticResource ErrorBrush}" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Chat area -->
            <Border Grid.Row="1" Background="{StaticResource DarkBgBrush}" Margin="12,10,12,0"
                    BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="12">
                <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled" Padding="16">
                    <StackPanel x:Name="ChatPanel">
                        <!-- Welcome message -->
                        <Border Background="White" BorderBrush="{StaticResource SurfaceBorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,8">
                            <StackPanel>
                                <TextBlock Text="Welcome to Voice Chatbot 2.0" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" Foreground="Black" FontSize="13">
                                    <Run Text="This app connects to your local Ollama instance for AI-powered voice conversation."/>
                                    <LineBreak/>
                                    <LineBreak/>
                                    <Run Text=" Click "/><Run Text="'Listen'" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    <Run Text=" to start a single voice interaction"/>
                                    <LineBreak/>
                                    <Run Text=" Toggle "/><Run Text="'Auto'" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    <Run Text=" for continuous hands-free conversation"/>
                                    <LineBreak/>
                                    <Run Text="Click "/><Run Text="'Mic'" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    <Run Text=" for push-to-talk mode"/>
                                    <LineBreak/>
                                    <LineBreak/>
                                    <Run Text="Model control examples:" FontWeight="Bold"/>
                                    <LineBreak/>
                                    <Run Text="Hermes stop current running llama.cpp model"/>
                                    <LineBreak/>
                                    <Run Text="Hermes start gpt-oss:120b"/>
                                    <LineBreak/>
                                    <Run Text="Hermes start gemma"/>
                                    <LineBreak/>
                                    <Run Text="Hermes start gemma 4b"/>
                                    <LineBreak/>
                                    <Run Text="Hermes start gemma 12b"/>
                                    <LineBreak/>
                                    <Run Text="Hermes start gemma speculative"/>
                                    <LineBreak/>
                                    <Run Text="Hermes start gemma 26b a4b"/>
                                    <LineBreak/>
                                    <Run Text="Hermes start mistral"/>
                                    <LineBreak/>
                                    <Run Text="Hermes start comfyui"/>
                                    <LineBreak/>
                                    <Run Text="Hermes stop comfyui"/>
                                    <LineBreak/>
                                    <LineBreak/>
                                    <Run Text="Configure your Ollama connection and voice settings in the left panel."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Waveform / activity bar -->
            <Border Grid.Row="2" Background="{StaticResource PanelBgBrush}" Padding="18,4" Height="38">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ActivityLabel" Text="" FontSize="11" 
                               Foreground="#55595E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ProgressBar x:Name="VolumeMeter" Grid.Column="1" Minimum="0" Maximum="100" Value="0"
                                 Height="8" Foreground="{StaticResource AccentBrush}" Background="#E7E9EB"
                                 VerticalAlignment="Center"/>
                    <TextBlock x:Name="TimerLabel" Grid.Column="2" Text="" FontSize="11"
                               Foreground="#55595E" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
            </Border>

            <!-- Text input area -->
            <Border Grid.Row="3" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="0,1,0,0" Padding="16,12" CornerRadius="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="MessageInput" Background="White" 
                             Foreground="Black" 
                             BorderBrush="#888888" FontSize="13" Padding="12,8"
                             AcceptsReturn="True" MaxHeight="120"
                             ToolTip="Type a message. Enter to send, Shift+Enter for new line."/>
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                            <Button x:Name="CameraBtn" Content="Camera"
                                    Style="{StaticResource ActionButton}" Margin="0,0,8,0"
                                    Click="CameraAsk_Click" MinWidth="80"
                                    ToolTip="Take one photo and ask what the assistant sees."/>
                            <Button x:Name="ImageBtn" Content="Image"
                                    Style="{StaticResource ActionButton}" Margin="0,0,8,0"
                                    Click="AttachImage_Click" MinWidth="80"
                                    ToolTip="Attach image files from this computer to the next message."/>
                            <Button x:Name="DocumentBtn" Content="Document"
                                    Style="{StaticResource ActionButton}" Margin="0,0,8,0"
                                    Click="AttachDocument_Click" MinWidth="95"
                                    ToolTip="Attach a PDF, Word document, or text file to the next message."/>
                            <CheckBox x:Name="KeepDocumentActiveToggle" Content="Keep doc"
                                      Foreground="#222222" VerticalAlignment="Center" Margin="0,0,8,0"
                                      Checked="KeepDocumentActiveToggle_Changed"
                                      Unchecked="KeepDocumentActiveToggle_Changed"
                                      ToolTip="When checked, the attached document stays in context for each question until unchecked."/>
                            <Button x:Name="CreateImageBtn" Content="Create"
                                    Style="{StaticResource ActionButton}" Margin="0,0,8,0"
                                    Click="CreateImage_Click" MinWidth="80"
                                    ToolTip="Create an image from the typed prompt using Qwen Image."/>
                            <Button x:Name="EditImageBtn" Content="Edit"
                                    Style="{StaticResource ActionButton}" Margin="0,0,8,0"
                                    Click="EditImage_Click" MinWidth="70"
                                    ToolTip="Edit the attached or last generated image using Qwen Image Edit."/>
                            <Button x:Name="AudioBtn" Content="Video Audio"
                                    Style="{StaticResource ActionButton}" Margin="0,0,8,0"
                                    Click="AttachVideoAudio_Click" MinWidth="105"
                                    ToolTip="Attach optional audio for the next video generation."/>
                            <Button x:Name="CreateVideoBtn" Content="Video"
                                    Style="{StaticResource ActionButton}" Margin="0,0,8,0"
                                    Click="CreateVideo_Click" MinWidth="70"
                                    ToolTip="Make a video from the attached or last generated image using ComfyUI."/>
                        </StackPanel>
                        <Button x:Name="SendBtn" Content="Send"
                                Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Style="{StaticResource ActionButton}"
                                Click="SendText_Click" MinWidth="80"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Button x:Name="SettingsMenuButton" Content="☰"
                Panel.ZIndex="20"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Style="{StaticResource ActionButton}"
                Click="SettingsMenuButton_Click"
                Width="42" Height="38" Padding="0"
                FontSize="18" Margin="12,14,0,0"
                ToolTip="Show or hide settings"/>
    </Grid>
</Window>
