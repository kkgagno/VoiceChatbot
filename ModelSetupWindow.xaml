<Window x:Class="VoiceChatbot.ModelSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VoiceChatbot"
        Title="Choose your AI model"
        Width="820" Height="860"
        MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource DarkBgBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        ShowInTaskbar="False">
    <!-- The option cards are built in ModelSetupWindow.xaml.cs from Core/LocalModelCatalog.cs. -->
    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBgBrush}" Padding="22,18,22,16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource BrandGradientBrush}">
                        <TextBlock Text="&#xE8F1;" Style="{StaticResource IconText}" FontSize="18" Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Choose your AI model" FontSize="18" FontWeight="Bold"/>
                        <TextBlock x:Name="IntroText" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Run a model on this PC (private, free, works offline) or use one on a server. You can change this any time with Choose AI model... under Chat Backend."/>
                    </StackPanel>
                </Grid>
                <Border Margin="0,14,0,0" Padding="12,9" CornerRadius="8" Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7F4;" Style="{StaticResource IconText}" FontSize="16" VerticalAlignment="Top" Margin="0,1,10,0"
                                   Foreground="{DynamicResource PrimaryLightBrush}"/>
                        <TextBlock x:Name="PcInfoText" Grid.Column="1" TextWrapping="Wrap" FontSize="12.5" Text="Checking this PC..."/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Buttons and download progress -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBgBrush}" Padding="22,12,22,14"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel>
                <StackPanel x:Name="DownloadPanel" Visibility="Collapsed" Margin="0,0,0,10">
                    <ProgressBar x:Name="DownloadBar" Height="8" Minimum="0" Maximum="1"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DownloadText" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Button x:Name="PauseDownloadBtn" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Pause download"
                                Margin="8,0,0,0" Click="PauseDownload_Click"
                                ToolTip="Stop for now; downloading it again continues where it stopped"/>
                    </Grid>
                </StackPanel>
                <TextBlock x:Name="ErrorText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
                           Foreground="{DynamicResource ErrorBrush}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="OpenModelsFolderBtn" Style="{StaticResource GhostButton}" local:Ui.Icon="&#xE838;"
                            Content="Models folder" Click="OpenModelsFolder_Click"
                            ToolTip="Open the folder where downloaded models are kept (delete files there to free disk space)"/>
                    <Button x:Name="CloseBtn" Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Skip for now"
                            Margin="0,0,8,0" Click="Close_Click" IsCancel="True"/>
                    <!-- Shown for a model on this PC without its picture support: use it as it is, text only. -->
                    <Button x:Name="UseTextOnlyBtn" Grid.Column="3" Style="{StaticResource SecondaryButton}" Content="Use without pictures"
                            Margin="0,0,8,0" Click="UseTextOnly_Click" Visibility="Collapsed"
                            ToolTip="Use this model now without downloading its picture support; it reads text only"/>
                    <Button x:Name="UseBtn" Grid.Column="4" Style="{StaticResource ActionButton}" Content="Use this model"
                            Click="Use_Click" IsDefault="True" MinWidth="150"/>
                </Grid>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="OptionsPanel" Margin="22,16,22,18"/>
        </ScrollViewer>
    </DockPanel>
</Window>
