<Window x:Class="VoiceChatbot.SchedulerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scheduler"
        Width="980" Height="640"
        MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#F0F0F5">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="6" Padding="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="New" Width="64" Margin="0,0,6,0" Click="NewTask_Click"/>
                    <Button Content="Delete" Width="72" Click="DeleteTask_Click"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="Scheduled Tasks" FontWeight="Bold" Foreground="#222222" Margin="0,0,0,8"/>
                <ListBox x:Name="TaskList" SelectionChanged="TaskList_SelectionChanged"/>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Background="White" CornerRadius="6" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Name" FontSize="11" Foreground="#444444"/>
                        <TextBox x:Name="NameBox" Margin="0,2,0,8"/>

                        <TextBlock Text="Prompt" FontSize="11" Foreground="#444444"/>
                        <TextBox x:Name="PromptBox" MinHeight="110" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" Margin="0,2,0,8"/>

                        <CheckBox x:Name="EnabledBox" Content="Enabled" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ShowInMainChatBox" Content="Show result in main chat" Margin="0,0,0,8"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Next Date" FontSize="11" Foreground="#444444"/>
                        <DatePicker x:Name="RunDatePicker" Margin="0,2,0,8"/>

                        <TextBlock Text="Time" FontSize="11" Foreground="#444444"/>
                        <TextBox x:Name="RunTimeBox" Text="09:00 AM" Margin="0,2,0,8"/>

                        <TextBlock Text="Recurrence" FontSize="11" Foreground="#444444"/>
                        <ComboBox x:Name="RecurrenceBox" Margin="0,2,0,8"/>

                        <TextBlock Text="Runs To Keep" FontSize="11" Foreground="#444444"/>
                        <TextBox x:Name="KeepRunsBox" Text="5" Margin="0,2,0,12"/>

                        <Button Content="Save Task" Click="SaveTask_Click" Margin="0,0,0,6"/>
                        <Button Content="Run Now" Click="RunNow_Click"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,12,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Saved Runs" FontWeight="Bold" Foreground="#222222" Margin="0,0,0,6"/>
                        <ListBox x:Name="RunList" Grid.Row="1" SelectionChanged="RunList_SelectionChanged"/>
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="SendToMainChatBtn" Content="Send to Main Chat" Width="130"
                                        Click="SendToMainChat_Click" IsEnabled="False" Margin="0,0,6,0"/>
                                <Button x:Name="PlayAudioBtn" Content="Play Audio" Width="90"
                                        Click="PlayAudio_Click" IsEnabled="False"/>
                            </StackPanel>
                            <TextBlock Text="Response" FontWeight="Bold" Foreground="#222222" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBox x:Name="ResponseBox" Grid.Row="1" TextWrapping="Wrap" AcceptsReturn="True"
                                 IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
                    </Grid>
                </Grid>

                <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="#555555" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
