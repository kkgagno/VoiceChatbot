<Window x:Class="VoiceChatbot.KnowledgeFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VoiceChatbot"
        Title="Knowledge Folder Files"
        Width="780" Height="560"
        MinWidth="520" MinHeight="340"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource DarkBgBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="2,0,2,10">
            <TextBlock x:Name="FolderText" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="SummaryText" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Column headers: click to sort, click again to reverse. -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SortNameBtn" Content="File" Style="{StaticResource GhostButton}" Padding="8,4"
                            HorizontalAlignment="Left" Click="SortName_Click" ToolTip="Sort by file name"/>
                    <Button x:Name="SortTypeBtn" Grid.Column="1" Content="Type" Style="{StaticResource GhostButton}" Padding="8,4"
                            HorizontalAlignment="Left" Click="SortType_Click" ToolTip="Sort by file type"/>
                    <Button x:Name="SortStatusBtn" Grid.Column="2" Content="Status" Style="{StaticResource GhostButton}" Padding="8,4"
                            HorizontalAlignment="Left" Click="SortStatus_Click"
                            ToolTip="Sort by status: could not be read and too large first, then skipped, then indexed"/>
                </Grid>

                <ListBox x:Name="FileList" Grid.Row="1"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         MouseDoubleClick="FileList_MouseDoubleClick" SelectionChanged="FileList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="280"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"
                                           ToolTip="{Binding FullPath}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Type}" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,10,0"/>
                                <TextBlock x:Name="StatusLabel" Grid.Column="2" Text="{Binding Status}" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextSecondaryBrush}" ToolTip="{Binding Detail}"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Tone}" Value="good">
                                    <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="bad">
                                    <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="warn">
                                    <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="muted">
                                    <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyText" Grid.Row="1" Visibility="Collapsed" TextWrapping="Wrap" Margin="8"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="False">
            <Button x:Name="OpenFolderBtn" Content="Open folder" local:Ui.Icon="&#xE838;" Style="{StaticResource SecondaryButton}"
                    Click="OpenFolder_Click" ToolTip="Show the knowledge folder in Explorer"/>
            <Button x:Name="ViewTextBtn" Content="View text" local:Ui.Icon="&#xE8A5;" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0"
                    Click="ViewText_Click" IsEnabled="False"
                    ToolTip="Show the selected file's text as the assistant reads it (select an indexed file)"/>
            <Button Content="Refresh" local:Ui.Icon="&#xE72C;" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                    Click="Refresh_Click" ToolTip="Show the latest list (it does not reindex)"/>
            <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource SecondaryButton}" IsCancel="True"
                    Click="Close_Click"/>
            <TextBlock DockPanel.Dock="Right" Text="Double-click a file to show it in Explorer." FontSize="11"
                       VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource TextMutedBrush}"/>
        </DockPanel>
    </Grid>
</Window>
