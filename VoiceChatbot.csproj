<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon); see MainWindow.Tray.cs. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StartupObject>VoiceChatbot.App</StartupObject>
    <RootNamespace>VoiceChatbot</RootNamespace>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyName>VoiceChatbot</AssemblyName>
    <Product>Voice Chatbot</Product>
    <Company>Keith Gagnon</Company>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms adds these implicit global usings; drop them so WPF names (Application,
         MessageBox, Button, Brush, Color, Point...) stay unambiguous. Name WinForms types explicitly. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test project has its own csproj; keep its sources out of the app. -->
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Markdig" Version="0.41.3" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20240616" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20240616" />
    <PackageReference Include="PdfPig" Version="0.1.14" />
    <PackageReference Include="Whisper.net" Version="1.7.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.7.1" />
    <!-- GPU Whisper on any Vulkan GPU (AMD Radeon, NVIDIA, Intel); falls back to Whisper.net.Runtime (CPU). -->
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.7.1" />
    <PackageReference Include="System.Speech" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded so the tray icon can load its 16x16 frame (MainWindow.Tray.cs). -->
    <Resource Include="Resources\AppIcon.ico" />
    <Content Include="Resources\Models\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\Kokoro\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Update="README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
