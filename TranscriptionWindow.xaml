<Window x:Class="VoiceChatbot.TranscriptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VoiceChatbot"
        Title="Live Transcriber"
        Width="1000" Height="760"
        MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource DarkBgBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        Closing="Window_Closing"
        Closed="Window_Closed">
    <Window.Resources>
        <!-- Horizontal bar between the transcript and summary panes. -->
        <Style x:Key="PaneSplitter" TargetType="GridSplitter">
            <Setter Property="Height" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="ResizeDirection" Value="Rows"/>
            <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
            <Setter Property="Cursor" Value="SizeNS"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="{TemplateBinding Background}">
                            <Border x:Name="grip" Width="48" Height="4" CornerRadius="2"
                                    Background="{DynamicResource BorderStrongBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="grip" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Drag handle under the system message box. -->
        <Style x:Key="ResizeGrip" TargetType="Thumb">
            <Setter Property="Height" Value="12"/>
            <Setter Property="Cursor" Value="SizeNS"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent">
                            <Border x:Name="grip" Width="40" Height="4" CornerRadius="2"
                                    Background="{DynamicResource BorderStrongBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="grip" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaneTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="AcceptsTab" Value="False"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16,14,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="TranscriptRow" Height="2*" MinHeight="120"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="SummaryRow" Height="*" MinHeight="80"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: title, status, elapsed time and level, source and Start/Stop. -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="Live Transcriber" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock x:Name="StatusText" Text="Ready" FontSize="12" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource Chip}" VerticalAlignment="Center" Margin="0,0,10,0"
                    ToolTip="Recording time and input level">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="RecordDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                             Fill="{DynamicResource TextMutedBrush}"/>
                    <TextBlock x:Name="ElapsedText" Text="00:00" FontFamily="{StaticResource CodeFont}" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="LevelMeter" Width="56" Height="4" Minimum="0" Maximum="100" Value="0"
                                 Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <ComboBox x:Name="SourceCombo" Grid.Column="2" Width="140" Margin="0,0,10,0" VerticalAlignment="Center"
                      SelectionChanged="SourceCombo_SelectionChanged"
                      ToolTip="Microphone: the microphone selected in the app. PC audio: everything the PC plays, such as a call or a video."/>

            <Button x:Name="StartStopBtn" Grid.Column="3" Content="Start" local:Ui.Icon="&#xE720;"
                    Style="{StaticResource ActionButton}" MinWidth="104" VerticalAlignment="Center"
                    Click="StartStop_Click" ToolTip="Start or stop recording (Ctrl+R)"/>
        </Grid>

        <!-- System message (collapsed by default, resizable by the grip under the box). -->
        <Expander x:Name="SystemPromptExpander" Grid.Row="1" Margin="0,12,0,10" IsExpanded="False"
                  Header="System message" local:Ui.Icon="&#xE713;"
                  local:Ui.Subtitle="What the chat model is told when it summarizes">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SystemPromptBox" Grid.ColumnSpan="2" Height="90" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontSize="12"/>
                <Thumb Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource ResizeGrip}" Margin="0,2,0,0"
                       DragDelta="SystemPromptGrip_DragDelta" ToolTip="Drag to resize"/>
                <Button Grid.Row="1" Grid.Column="1" Content="Reset to default" Style="{StaticResource GhostButton}"
                        FontSize="11" Padding="8,3" Margin="0,2,0,0" Click="ResetSystemPrompt_Click"/>
            </Grid>
        </Expander>

        <!-- Transcript -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12,10,12,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" local:Ui.Icon="&#xE8E7;" Click="FontSmaller_Click"
                                ToolTip="Smaller text (Ctrl+mouse wheel)"/>
                        <Button Style="{StaticResource IconButton}" local:Ui.Icon="&#xE8E8;" Click="FontLarger_Click"
                                ToolTip="Larger text (Ctrl+mouse wheel)" Margin="0,0,6,0"/>
                        <Button Content="Copy" local:Ui.Icon="&#xE8C8;" Style="{StaticResource GhostButton}"
                                Click="CopyTranscript_Click" ToolTip="Copy the transcript"/>
                        <Button x:Name="ClearBtn" Content="Clear" local:Ui.Icon="&#xE74D;" Style="{StaticResource GhostButton}"
                                Click="Clear_Click" ToolTip="Start a new session: clears the transcript and notes. The session so far is saved to the transcripts folder first."/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="TRANSCRIPT" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatsText" Text="0 words" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock x:Name="EditHintText" Text="Editable while stopped" FontSize="11" Margin="10,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </DockPanel>
                <TextBox x:Name="TranscriptBox" Grid.Row="1" Style="{StaticResource PaneTextBox}"
                         local:Ui.Placeholder="Press Start (Ctrl+R). Each pause in speech adds a timestamped line here."
                         TextChanged="TranscriptBox_TextChanged"/>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="3" Style="{StaticResource PaneSplitter}" DragCompleted="PaneSplitter_DragCompleted"
                      ToolTip="Drag to resize the transcript and notes"/>

        <!-- Summary -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="12,10,12,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ToggleButton x:Name="LiveNotesToggle" Content="Live notes" local:Ui.Icon="&#xE70B;"
                                      Style="{StaticResource ToggleFlatButton}" Padding="10,7" Margin="0,0,6,0"
                                      VerticalAlignment="Center" Click="LiveNotesToggle_Click"
                                      ToolTip="While recording, every few minutes the chat model writes detailed notes on what was said since the last update as a new section under NOTES BY TIME, and refreshes the summary at the top. Stop then writes a full summary in the chosen style."/>
                        <ComboBox x:Name="LiveNotesIntervalCombo" Width="84" Margin="0,0,14,0" VerticalAlignment="Center"
                                  SelectionChanged="LiveNotesIntervalCombo_SelectionChanged"
                                  ToolTip="How often live notes are updated while recording. Re-summarize all also uses it as the length of each section."/>
                        <ComboBox x:Name="SummaryStyleCombo" Width="150" Margin="0,0,8,0" VerticalAlignment="Center"
                                  ToolTip="How the summary at the top of the notes is written"/>
                        <Button x:Name="SummarizeBtn" Content="Summarize" local:Ui.Icon="&#xE9D5;"
                                Style="{StaticResource SecondaryButton}" MinWidth="112" Click="Summarize_Click"
                                ToolTip="Write notes by time and a summary in the chosen style from the whole transcript"/>
                        <Button Content="Copy" local:Ui.Icon="&#xE8C8;" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                                Click="CopySummary_Click" ToolTip="Copy the notes"/>
                    </StackPanel>
                    <DockPanel VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock x:Name="SummaryHeaderText" DockPanel.Dock="Left" Text="NOTES" Style="{StaticResource SectionLabel}"
                                   Margin="0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="NotesUpdatedText" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </DockPanel>
                <TextBox x:Name="SummaryBox" Grid.Row="1" Style="{StaticResource PaneTextBox}"
                         local:Ui.Placeholder="Turn on Live notes to have notes by time written while you record, or press Summarize after recording."
                         TextChanged="SummaryBox_TextChanged"/>
            </Grid>
        </Border>

        <!-- Footer: shortcuts and output. -->
        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterText" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="11"
                       Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"
                       Text="Ctrl+R start/stop · Ctrl+S save · Ctrl+wheel text size · Sessions are saved to the transcripts folder when you stop, and come back when you reopen this window."/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Open folder" local:Ui.Icon="&#xE838;" Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                        Click="OpenFolder_Click" ToolTip="Open the folder with the saved transcripts"/>
                <Button Content="Save..." local:Ui.Icon="&#xE74E;" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Click="Save_Click" ToolTip="Save the transcript and notes as Markdown or text (Ctrl+S)"/>
                <Button x:Name="SendToChatBtn" Content="Send to chat" local:Ui.Icon="&#xE724;" Style="{StaticResource SecondaryButton}"
                        Click="SendToChat_Click" ToolTip="Give the transcript (and notes) to the main chat and ask about it there"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
