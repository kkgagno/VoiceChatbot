<Window x:Class="VoiceChatbot.TranscriptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live Transcriber"
        Width="760" Height="620"
        MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E2E"
        Closing="Window_Closing">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Live Transcriber" Foreground="#CDD6F4" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="#A6ADC8" FontSize="12" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="StartStopBtn" Content="Start Transcribing" Click="StartStop_Click"
                        Background="#89B4FA" Foreground="#11111B" BorderThickness="0"
                        Padding="14,7" MinWidth="135" Margin="0,0,8,0"/>
                <Button x:Name="ClearBtn" Content="Clear" Click="Clear_Click"
                        Background="#45475A" Foreground="#CDD6F4" BorderThickness="0"
                        Padding="14,7" MinWidth="70"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#313244" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="TRANSCRIBER SYSTEM MESSAGE" Foreground="#A6ADC8" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button x:Name="SavePromptBtn" Grid.Column="1" Content="Save Message" Click="SavePrompt_Click"
                            Background="#A6E3A1" Foreground="#11111B" BorderThickness="0"
                            Padding="10,5" MinWidth="105"/>
                </Grid>
                <TextBox x:Name="SystemPromptBox" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="58" MaxHeight="92"
                         Foreground="#11111B" Background="#F5F5FA" BorderBrush="#585B70"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#11111B" CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <Grid>
                <TextBox x:Name="TranscriptBox" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" BorderThickness="0"
                         Background="#11111B" Foreground="#CDD6F4" FontSize="14"
                         IsReadOnly="True"/>
                <TextBlock x:Name="EmptyTranscriptText" Text="Transcript will appear here while recording."
                           Foreground="#6C7086" FontSize="14" HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatsText" Text="0 words" Foreground="#A6ADC8" VerticalAlignment="Center"/>
            <Button x:Name="SummarizeBtn" Grid.Column="1" Content="Summarize" Click="Summarize_Click"
                    Background="#A6E3A1" Foreground="#11111B" BorderThickness="0"
                    Padding="16,7" MinWidth="105"/>
        </Grid>

        <GridSplitter Grid.Row="4" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Background="#45475A" ShowsPreview="True" Margin="0,0,0,10"/>

        <Border Grid.Row="5" Background="#181825" CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <TextBox x:Name="SummaryBox" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" BorderThickness="0"
                     Background="#181825" Foreground="#CDD6F4" FontSize="13"
                     IsReadOnly="True"/>
        </Border>

        <TextBlock Grid.Row="6" Text="The main chat can use this transcript and summary as context."
                   Foreground="#A6ADC8" FontSize="11"/>
    </Grid>
</Window>
